import pandas as pd
import numpy as np
import re

df = pd.read_csv("birbeck.txt", sep="\t", header=None)

correct_words = set()

for line in df[0]:
    words = re.findall(r"[a-zA-Z]+", str(line).lower())
    correct_words.update(words)

def edit_distance(word1, word2):
    m = len(word1)
    n = len(word2)

    dp = np.zeros((m + 1, n + 1), dtype=int)

    for i in range(m + 1):
        dp[i][0] = i

    for j in range(n + 1):
        dp[0][j] = j

    for i in range(1, m + 1):
        for j in range(1, n + 1):
            if word1[i - 1] == word2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1]
            else:
                dp[i][j] = 1 + min(
                    dp[i - 1][j],
                    dp[i][j - 1],
                    dp[i - 1][j - 1]
                )

    return dp[m][n]


def correct_query(query):
    tokens = re.findall(r"[a-zA-Z]+", query.lower())
    corrected_words = []
    incorrect_words = []
    suggestions = []

    for word in tokens:
        if word in correct_words:
            corrected_words.append(word)
        else:
            incorrect_words.append(word)

            distances = {
                candidate: edit_distance(word, candidate)
                for candidate in correct_words
                if abs(len(candidate) - len(word)) <= 2
            }

            if distances:
                best_word = min(distances, key=distances.get)
                corrected_words.append(best_word)
                suggestions.append((word, best_word))
            else:
                corrected_words.append(word)

    return corrected_words, incorrect_words, suggestions


query = input("Enter search query: ")

corrected_words, incorrect_words, suggestions = correct_query(query)

corrected_query = " ".join(corrected_words)

print("\nOriginal Query:", query)

print("\nIncorrect Words:")
print(incorrect_words)

print("\nSuggested Corrections:")
for wrong, correct in suggestions:
    print(wrong, "->", correct)

print("\nFinal Corrected Query:")
print(corrected_query)
